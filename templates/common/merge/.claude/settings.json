{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "{{MARKETPLACE}}": {
      "source": {
        "source": "github",
        "repo": "{{FACTORY_REPO}}"
      }
    }
  },
  "enabledPlugins": {
    "factory@{{MARKETPLACE}}": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(yarn run *)",
      "Bash(yarn test *)",
      "Bash(bun run *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(yarn install --frozen-lockfile*)",
      "Bash(bun install --frozen-lockfile*)",
      "Bash(npx tsc *)",
      "Bash(node *scripts/verify.mjs*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
    ]
  }
}
